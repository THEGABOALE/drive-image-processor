# Copiar como .env.development.local o .env.production.local (ignorados por Git).
# Cada entorno usa su propio proyecto de Google Cloud: no mezclar valores.
# No hay secreto de un cliente OAuth web: este cliente solo usa el flujo del navegador.

# development o production. Se define en el entorno al iniciar, no en este archivo.
DIP_ENV=

# ID y número del proyecto de Google Cloud de este entorno.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Ruta al JSON del cliente OAuth de tipo "aplicación de escritorio" de este proyecto.
# Solo se lee.
GOOGLE_DESKTOP_CLIENT_FILE=

# Cliente OAuth de tipo "aplicación web" y clave de API de Google Picker.
# Son valores públicos: el navegador los recibe.
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
